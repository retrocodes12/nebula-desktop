{
  "name": "clearkey-player",
  "version": "1.44.0",
  "description": "Nebula \u2014 add an add-on, browse it, press play. Every format, on-device.",
  "main": "main.js",
  "author": "Nebula",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^31.7.6",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.nuvio.clearkey.player",
    "productName": "Nebula",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Nebula-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Nebula-Portable.exe"
    }
  }
}
